NODE_ENV=production
# Supabase: use the PostgreSQL connection string from Project Settings > Database.
# For a long-running Node API use the Session Pooler connection string if IPv6/direct access is unavailable.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
# Generate a unique random secret of at least 32 characters. Never expose it in frontend variables.
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
# Optional comma-separated origins when the frontend is on a different hostname. Same-origin Vercel deployment needs no CORS setting.
FRONTEND_ORIGIN=
